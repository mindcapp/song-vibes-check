SECRET_KEY=change-me-to-a-long-random-string

# Either set DATABASE_URL directly...
DATABASE_URL=postgres://user_service:user_service@localhost:5432/user_service?sslmode=disable

# ...or configure connection params individually (used only if DATABASE_URL is unset).
DB_HOST=localhost
DB_PORT=5432
DB_USER=user_service
DB_PASSWORD=user_service
DB_NAME=user_service
DB_SSLMODE=disable
