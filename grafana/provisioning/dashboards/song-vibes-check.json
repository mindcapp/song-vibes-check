      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Доля ошибок 5xx",
      "description": "Доля ответов 5xx среди всех ответов POST /compare. 502 означает, что MusicBrainz недоступен. Панель пуста, пока не было ни одного ответа 5xx.",
