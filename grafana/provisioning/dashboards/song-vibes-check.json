          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{path=\"/compare\",status=~\"5..\"}[$__rate_interval])) / sum(rate(http_requests_total{path=\"/compare\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
