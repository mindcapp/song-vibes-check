# Variables read by docker-compose.yml. Copy to .env and fill in.
# .env is git-ignored; never commit real values.

# Required by user-service, which refuses to start without a key of at least
# 32 characters. Generate one with: openssl rand -hex 32
USER_SERVICE_SECRET_KEY=

# Password of the user-service database. Leave empty to use the local
# development default from docker-compose.yml.
POSTGRES_PASSWORD=

# Grafana admin password. Leave empty to use the local development default.
GF_ADMIN_PASSWORD=

# Only needed for the mood profile (docker compose --profile mood up).
GENIUS_API_KEY=

# Only needed for similar-track search (docker compose --profile vectors up).
# Leave QDRANT_URL empty to keep /api/v1/similar and /api/v1/tracks/search off.
QDRANT_URL=
QDRANT_COLLECTION=tracks
# Only if Qdrant runs with authentication enabled.
QDRANT_API_KEY=

# Only for rerank=true on /api/v1/similar (listener behaviour from the lab-events
# ClickHouse). Leave CLICKHOUSE_URL empty to keep rerank off. The API in
# docker-compose does not read these: run it on the host (go run ./cmd/server).
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=vibe
CLICKHOUSE_TIMEOUT=500ms
RERANK_WEIGHT=0.3
RERANK_SMOOTHING=5
