# Variables read by docker-compose.yml. Copy to .env and fill in.
# .env is git-ignored; never commit real values.

# Required by user-service, which refuses to start without a key of at least
# 32 characters. Generate one with: openssl rand -hex 32
USER_SERVICE_SECRET_KEY=

# Password of the user-service database. Leave empty to use the local
# development default from docker-compose.yml.
POSTGRES_PASSWORD=

# Grafana admin password. Leave empty to use the local development default.
GF_ADMIN_PASSWORD=

# Only needed for the mood profile (docker compose --profile mood up).
GENIUS_API_KEY=
